NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are accepted while migrating existing Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only Supabase secret. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy service_role key is accepted if the project has not moved to secret keys.
SUPABASE_SERVICE_ROLE_KEY=
